#!/bin/sh

# Stop the failover monitor before its files are removed or replaced.
RCD=/usr/local/etc/rc.d/fritzfailover
SCRIPT=/usr/local/opnsense/scripts/OPNsense/FritzFailover/fritzbox_failover.sh

if [ -x "${RCD}" ]; then
	# onestop also works when the service is disabled; the post-stop hook
	# keeps an active failover, so an update does not switch lines
	"${RCD}" onestop >/dev/null 2>&1 || :
fi

if [ "${PKG_UPGRADE:-}" != "true" ] && [ -x "${SCRIPT}" ]; then
	# real removal: the plugin will no longer manage the gateway, so put the
	# normal monitor IP back if the fake one is active
	echo "Restoring the normal gateway monitor IP"
	"${SCRIPT}" restore >/dev/null 2>&1 || :
	# empty the plugin's own routing tables (net.fibs itself shrinks at reboot)
	B=$(cat /var/db/fritzfailover/fib_base 2>/dev/null)
	case "${B}" in
	''|*[!0-9]*) ;;
	*)
		setfib "${B}" route -q flush >/dev/null 2>&1 || :
		setfib $((B + 1)) route -q flush >/dev/null 2>&1 || :
		;;
	esac
	# switch history, debug log
	rm -rf /var/db/fritzfailover
fi
