#!/bin/sh

# (Re)start the failover monitor after an install or update if it is enabled.
RCD=/usr/local/etc/rc.d/fritzfailover

if [ -x "${RCD}" ] && "${RCD}" enabled; then
	echo "Restarting FRITZ!Box failover monitor"
	"${RCD}" restart >/dev/null 2>&1 || :
fi

# load (or drop) the plugin's firewall rules for the test pings
if [ -x /usr/local/sbin/configctl ]; then
	/usr/local/sbin/configctl filter reload skip_alias >/dev/null 2>&1 || :
fi
